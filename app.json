{
  "expo": {
    "name": "Registless",
    "slug": "registless",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "registless",
    "userInterfaceStyle": "automatic",
    "icon": "./icon.png",

    "android": {
      "package": "com.starlabs.registless",
      "versionCode": 1,
      "icon": "./icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#1a0000"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },

    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-camera",
      "expo-notifications",
      "expo-secure-store"
    ],

    "extra": {
      "eas": {
        "projectId": "08da73b8-650a-4f46-9764-d91b95d2bb29"
      }
    }
  }
}
