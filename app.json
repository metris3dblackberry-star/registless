{
  "expo": {
    "name": "Registless",
    "slug": "registless",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "registless",
    "userInterfaceStyle": "automatic",

    "android": {
      "package": "com.starlabs.registless",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "NOTIFICATIONS"
      ]
    },

    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21"
          }
        }
      ],
      "expo-camera",
      "expo-notifications",
      "expo-secure-store"
    ],

    "extra": {
      "eas": {
        "projectId": "08da73b8-650a-4f46-9764-d91b95d2bb29"
      }
    }
  }
}