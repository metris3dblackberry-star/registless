{
  "expo": {
    "name": "Registless",
    "slug": "registless",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "registless",
    "userInterfaceStyle": "automatic",
    "icon": "./icon.png",
    "android": {
      "package": "com.starlabs.registless",
      "versionCode": 1,
      "icon": "./icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#1a0000"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "NOTIFICATIONS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21"
          }
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Az app a naptárad időpontjait olvassa."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Az app a helyzetedet használja közeli szolgáltatók kereséséhez."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-camera",
      "expo-notifications",
      "expo-secure-store",
      "expo-video",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "f176b840-e2af-4a2b-b653-ae9f518cda1c"
      }
    },
    "owner": "starlabss-organization"
  }
}
